rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    function isValidSearchLog(data) {
      return data.keys().hasAll(['userId', 'city', 'timestamp', 'response']) &&
             data.userId is string &&
             data.city is string && data.city.size() <= 200 &&
             data.timestamp is number &&
             data.response is map;
    }
    match /search_logs/{logId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && isValidSearchLog(request.resource.data);
    }
  }
}
